# Ignore node_modules
node_modules/

# Ignore build output
dist/
build/

# Ignore development files
.env
.env.local
.env.*.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/

# Ignore database files (will be in volume)
*.db
*.sqlite
*.sqlite3

# Ignore git
.git/
.gitignore
