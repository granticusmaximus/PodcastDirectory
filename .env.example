# Server Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=your-secret-key-change-in-production

# Email Configuration (Optional - for password reset feature)
# If not configured, reset links will be logged to console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@podcastdirectory.com

# Application URL (for email reset links)
APP_URL=http://localhost:5174
